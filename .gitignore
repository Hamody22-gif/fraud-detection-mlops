# --- Data is versioned by DVC ---
# DVC auto-adds precise ignores for the actual data files (in data/**/.gitignore),
# while the small *.dvc pointer files ARE committed to git.


# --- Python virtual environment (uv creates .venv) ---
.venv/
__pycache__/
*.py[cod]

# --- Tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Secrets & local config (Kaggle keys, cloud creds, etc.) ---
.env
kaggle.json

# --- OS / editor noise ---
.DS_Store
.vscode/
.idea/

# Trained model artifacts
models/

# MLflow local backend + artifacts
mlflow.db
mlartifacts/
mlruns/
